# Object files & static libs (only in build output, not SDK libs)
*.o
projects/*/Output/**/*.a

# Code::Blocks generated files
*.depend
*.layout

# Build output objects directory
projects/*/Output/obj/

# Build output binaries directory - xmaker-generated only
projects/*/Output/bin/ui.bin
projects/*/Output/bin/res.bin
projects/*/Output/bin/xcfg.bin
projects/*/Output/bin/app.bin
projects/*/Output/bin/*.xbf
projects/*/Output/bin/*.rv32
projects/*/Output/bin/*.dcf
projects/*/Output/bin/*.o
projects/*/Output/bin/appxm.o

# Linker map
projects/*/Output/bin/map.txt

# Generated C headers (regenerated from .xm by xmaker)
projects/*/Output/bin/res.h
projects/*/Output/bin/ui.h
projects/*/Output/bin/ui_external.h
projects/*/Output/bin/xcfg.h
