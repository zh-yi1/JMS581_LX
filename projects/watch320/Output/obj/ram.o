__max_flash_size = (0xEA000 + 0x4000*(1) + 0x3000*(1||(1)*0) + 0x4000*(0) + 0x2000*(1) + 0x7000*(0) + 0x7000*(0) + 0xFA000*(0) + 0x15000*(0) + 0xA5000*(0 * 0));
__base = 0x10000000;
__stack_vma = 0x10800;
__bram_vma = 0x10C00;
__cram_vma = 0x1AC00;
